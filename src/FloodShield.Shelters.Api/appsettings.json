{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=FloodShieldShelters;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "FloodShield.Shelters.Api",
    "Audience": "FloodShield.Clients",
    "ExpiresMinutes": 60,
    "Key": ""
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "AuthPermitLimit": 5,
    "WindowSeconds": 60
  },
  "ExternalServices": {
    "JavaBackendHealthUrl": ""
  },
  "Seed": {
    "AdminEmail": "admin@floodshield.local",
    "AdminPassword": ""
  }
}
